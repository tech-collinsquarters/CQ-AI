# Supabase public client configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only Supabase credential (never expose with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Runtime uses the Supabase transaction-mode pooler (normally port 6543).
DATABASE_URL=
# Prisma migrations use the direct/session connection (normally port 5432).
DIRECT_URL=
# Maximum PostgreSQL connections per application instance.
DATABASE_POOL_MAX=3

# Amazon Bedrock. In production, prefer an IAM workload role and omit static
# access keys. Local development may use a scoped IAM access key.
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=anthropic.claude-opus-4-8

# Branding used in AI prompts and quota messages
FIRM_NAME=Collins Quarters
FIRM_WEBSITE_URL=https://collinsquarters.com

# Analytics. Optional - when unset, no analytics script is loaded.
# Google Analytics 4 measurement ID (https://analytics.google.com) — format G-XXXXXXXXXX.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Microsoft Clarity project ID (https://clarity.microsoft.com).
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Web search (Tavily, https://tavily.com). Optional - when unset, the
# assistant has no web_search tool and behaves exactly as it does today.
TAVILY_API_KEY=
# Optional comma-separated domain allowlist passed to Tavily's include_domains
# (e.g. restrict to legislation.gov.uk,gov.uk). Left unset searches the open web.
WEB_SEARCH_ALLOWED_DOMAINS=
